{
  "name": "majin-v4-desktop",
  "version": "4.0.0-alpha.3",
  "description": "MAJIN V4 Windows client for the shared private host",
  "author": "MAJIN contributors",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "stage": "node stage-host.mjs",
    "build": "npm run stage && electron-builder --win nsis --x64",
    "pack": "npm run stage && electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.majin.v4",
    "productName": "MAJIN V4",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "offline.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/host",
        "to": "host"
      },
      {
        "from": "stage/host/node_modules",
        "to": "host/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../src/v4/ui/icons/icon-512.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "stage/icon.ico",
      "artifactName": "MAJIN-V4-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
