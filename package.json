{
  "name": "majin",
  "version": "0.9.17",
  "description": "MAJIN \u00e2\u20ac\u201d a tiny always-on agent for Windows. All tools on. MOA on. Your keys, your models. Reverse engineering included.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "majin": "./src/cli/majin.js"
  },
  "main": "./src/core/runtime.js",
  "exports": {
    ".": "./src/core/runtime.js",
    "./config": "./src/core/config.js",
    "./tools": "./src/core/tools/index.js"
  },
  "scripts": {
    "start": "node ./src/cli/majin.js start",
    "serve": "node ./src/cli/majin.js _serve --no-window --no-channels",
    "window": "node ./src/cli/majin.js window",
    "doctor": "node ./src/cli/majin.js doctor",
    "doctor:full": "node ./src/cli/majin.js doctor --full",
    "test": "node --test test/*.test.js",
    "check": "node ./scripts/parse-all.js",
    "i18n": "node ./scripts/i18n-check.mjs",
    "pair": "node ./src/cli/majin.js pair",
    "ui": "node ./src/cli/majin.js window",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1",
    "setup:whatsapp": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1 -WhatsApp",
    "uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1 -Uninstall",
    "clean": "node ./scripts/clean.js",
    "exe": "node scripts/build-exe.mjs",
    "exe:all": "node scripts/build-exe.mjs --all",
    "exe:bundle": "node scripts/build-exe.mjs --no-pkg",
    "bench": "node ./scripts/bench.mjs",
    "bench:json": "node ./scripts/bench.mjs --json",
    "icon": "node ./scripts/set-icon.mjs",
    "shortcut": "node ./src/cli/majin.js shortcut",
    "setup:exe": "node ./scripts/build-setup.mjs",
    "setup:payload": "node ./scripts/build-setup.mjs --payload-only",
    "installer": "node ./scripts/build-installer.mjs",
    "win:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-on-windows.ps1",
    "win:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-on-windows.ps1 -SkipBuild",
    "test:ui": "node scripts/phoenix-browser.mjs"
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode": "1.5.4"
  },
  "files": [
    "src",
    "rules",
    "docs",
    "scripts",
    "test",
    "README.md",
    "install.ps1",
    "start-majin.cmd",
    "uninstall-majin.cmd",
    "majin.bat"
  ],
  "keywords": [
    "agent",
    "windows",
    "reverse-engineering",
    "moa",
    "telegram",
    "whatsapp",
    "jarvis"
  ],
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "esbuild": "^0.24.0",
    "js-yaml": "^5.5.0",
    "playwright": "^1.64.1",
    "resedit": "^3.1.0"
  }
}
