{
  "name": "majin",
  "version": "4.0.0-alpha.3",
  "description": "MAJIN — private, mobile-first AI assistant that executes on your own Windows machine.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "majin": "./bin/majin.mjs",
    "majin-v2": "./bin/majin-v2.mjs",
    "majin-v5": "./bin/majin-v5.mjs"
  },
  "main": "./src/core/runtime.js",
  "exports": {
    ".": "./src/core/runtime.js",
    "./config": "./src/core/config.js",
    "./tools": "./src/core/tools/index.js"
  },
  "scripts": {
    "start": "node ./bin/majin.mjs start",
    "serve": "node ./bin/majin.mjs serve",
    "window": "node ./bin/majin.mjs window",
    "doctor": "node ./bin/majin.mjs doctor",
    "doctor:full": "node ./bin/majin.mjs doctor --full",
    "test": "node --test test/*.test.js",
    "check": "node ./scripts/parse-all.js",
    "i18n": "node ./scripts/i18n-check.mjs",
    "pair": "node ./bin/majin.mjs pair",
    "ui": "node ./bin/majin.mjs window",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1",
    "setup:whatsapp": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1 -WhatsApp",
    "uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1 -Uninstall",
    "clean": "node ./scripts/clean.js",
    "exe": "node scripts/build-exe.mjs",
    "exe:all": "node scripts/build-exe.mjs --all",
    "exe:bundle": "node scripts/build-exe.mjs --no-pkg",
    "bench": "node ./scripts/bench.mjs",
    "bench:json": "node ./scripts/bench.mjs --json",
    "eval:live": "node ./scripts/eval-live.mjs",
    "icon": "node ./scripts/set-icon.mjs",
    "shortcut": "node ./bin/majin.mjs legacy shortcut",
    "setup:exe": "node ./scripts/build-setup.mjs",
    "setup:payload": "node ./scripts/build-setup.mjs --payload-only",
    "installer": "node ./scripts/build-installer.mjs",
    "win:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-on-windows.ps1",
    "win:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-on-windows.ps1 -SkipBuild",
    "test:ui": "node scripts/phoenix-browser.mjs",
    "v4": "node ./src/v4/main.js",
    "v4:pair": "node ./src/v4/main.js pair",
    "v4:test": "node --test test/v4/*.test.js",
    "v4:icons": "node ./scripts/v4/make-icons.mjs",
    "v4:doctor": "node ./scripts/v4/host-doctor.mjs",
    "v4:progress": "node ./scripts/v4/progress.mjs",
    "v4:bench": "node ./scripts/v4/benchmark.mjs --write",
    "v4:plugins": "node ./scripts/v4/plugin.mjs",
    "v4:e2e": "node --test test/v4/e2e.browser.test.js",
    "v4:accept": "node ./scripts/v4/accept.mjs",
    "v4:serve:supervised": "node ./scripts/v4/supervise.mjs",
    "v4:backup": "node ./scripts/v4/backup.mjs",
    "v4:upgrade": "node ./scripts/v4/upgrade.mjs",
    "v4:logs": "node ./scripts/v4/logs.mjs",
    "v4:tools": "node ./scripts/v4/tools.mjs",
    "v4:setup": "node ./scripts/v4/setup.mjs",
    "v4:update": "node ./scripts/v4/update.mjs",
    "v4:release": "node ./scripts/v4/release.mjs",
    "v4:inventory": "node ./scripts/v4/inventory.mjs",
    "v4:learn-accept": "node ./scripts/v4/learn-accept.mjs",
    "v4:approvals": "node ./scripts/v4/approvals.mjs",
    "v5:serve": "node ./bin/majin-v5.mjs serve",
    "v5:test": "node --test test/v5/*.test.js",
    "v5:accept": "node ./scripts/v5/accept.mjs",
    "v5:build": "node ./scripts/v5/build-package.mjs",
    "v5:screenshots": "node ./scripts/v5/render-screenshots.mjs"
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode": "1.5.4"
  },
  "files": [
    "bin",
    "src",
    "rules",
    "docs",
    "scripts",
    "test",
    "README.md",
    "install.ps1",
    "start-majin.cmd",
    "uninstall-majin.cmd",
    "majin.bat"
  ],
  "keywords": [
    "agent",
    "windows",
    "reverse-engineering",
    "moa",
    "telegram",
    "whatsapp",
    "jarvis"
  ],
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "esbuild": "^0.24.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "resedit": "^3.1.0"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "chokidar": "4.0.3",
    "node-edge-tts": "1.2.11",
    "p-queue": "10.0.0",
    "pngjs": "7.0.0",
    "playwright-core": "^1.64.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  }
}
